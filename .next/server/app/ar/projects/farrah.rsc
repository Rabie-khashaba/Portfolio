10:["$","$L19",null,{"locale":"ar","now":"$D2026-09-09T13:26:40.897Z","timeZone":"Africa/Cairo","messages":{"nav":{"home":"الرئيسية","about":"من أنا","projects":"المشاريع","services":"الخدمات","skills":"المهارات","contact":"تواصل"},"site":{"logo":"ر.ك","role":"مهندس باك إند أول · معمار لارافيل","switchLang":"English"},"hero":{"hello":"مرحباً، أنا","name":"ربيع عبد الرحمن","role":"مهندس Laravel 12 · مهندس PHP وأنظمة الذكاء الاصطناعي","summary":"أصمم وأبني منصات باك إند مؤسسية عالية الأداء في Laravel 12 وPHP 8.2 وPython وخدمات الذكاء الاصطناعي — لدعم واجهات API للجوال، محركات التجارة الإلكترونية، والمنتجات الرقمية التفاعلية.","ctaProjects":"استكشف دراسات الحالة","ctaContact":"تواصل معي","available":"متاح للمشاريع","experience":"5+ سنوات","experienceLabel":"خبرة في الإنتاج","shippedApps":"7 منتجات تابعة","shippedAppsLabel":"أنظمة مؤسسية","apisCount":"10+ واجهات رئيسية","apisCountLabel":"تم تطويرها ونشرها"},"about":{"eyebrow":"01 / الخبرات","title":"أنظمة باك إند مصممة للموثوقية، السرعة، والتوسع الحقيقي.","text":"أتحصص في بناء بنية تحتية آمنة وقابلة للصيانة وعالية الأداء لدعم سير العمليات المعقدة. من هندسة API وقواعد البيانات والمصادقة متعددة الأدوار إلى مدفوعات Webhooks والاتصالات اللحظية وخدمات الذكاء الاصطناعي.","tags":["لارافيل باك إند","هندسة API","تحسين قواعد البيانات","Python / FastAPI ML","مدفوعات Webhooks","اتصالات لحظية WebSockets","تخزين سحابي AWS","حماية وصلاحيات RBAC"]},"projects":{"eyebrow":"02 / دراسات الحالة","title":"المشاريع المنفذة والبنية البرمجية","description":"دراسات حالة تفصيلية لمنصات باك إند، محركات توصيل الطعام، خدمات الذكاء الاصطناعي، وأنظمة الإدارة.","filterAll":"جميع المشاريع","filterMobile":"الباك إند والجوال والذكاء الاصطناعي","filterEcommerce":"التوصيل والتجارة الإلكترونية","filterEnterprise":"أنظمة المؤسسات والعمليات","filterRealEstate":"العقارات والمنصات","viewCaseStudy":"عرض دراسة الحالة","keyMetrics":"مؤشرات الأداء الرئيسية"},"projectDetail":{"backToProjects":"← العودة إلى المشاريع","overviewTitle":"النظرة العامة والتنفيذية للمشروع","architectureTitle":"بنية النظام والطبقات البرمجية","databaseEntitiesTitle":"قاعدة البيانات والكيانات الرئيسية","apiContractsTitle":"واجهات API والعقود البرمجية","techStackTitle":"التقنيات المستخدمة","statsTitle":"أبرز مميزات المشروع","yearLabel":"الفترة الزمنية","platformsLabel":"المنصات المستهدفة","apiEndpointsLabel":"واجهات API","viewGithub":"الكود المصدري","viewDemo":"النظام المباشر","items":{"farrah":{"title":"Farrah (Farra / Wanderr)","subtitle":"خلفية تطبيق جوال للسفر والتواصل الاجتماعي ولوحة تحكم الإدارة","description":"منصة كاملة تعتمد على Laravel 12 ولوحة تحكم إدارية لتطبيق جوال متخصص في السفر واكتشاف الأماكن. تدعم مصادقة الجوال، المنشورات، المنشورات الخفية، تسجيل الدخول في المواقع، البحث الجغرافي عبر Mapbox، القصص، الدردشة اللحظية مع التفاعلات، تحويل الفيديو في الخلفية، إشعارات Firebase، مدفوعات Fawaterak، حملات ترويج المنشورات، وأدوات الإشراف.","problem":"معالجة التفاعلات الاجتماعية كثيفة الحجم، البحث الجغرافي، وتحويل الفيديو في الخلفية مع الحفاظ على سرعة استجابة API.","solution":"بناء API معياري في Laravel مع عمال Redis لمعالجة الفيديو، Pusher للدردشة اللحظية، Mapbox للخرائط، وFawaterak للمدفوعات."},"baby-track":{"title":"Baby Track","subtitle":"منصة تتبع العناية بالطفل وتحليل البكاء بالذكاء الاصطناعي","description":"يجمع Baby Track بين خلفية Laravel 12 وخدمة microservice مخصصة في Python FastAPI لتصنيف بكاء الأطفال عبر الذكاء الاصطناعي. يمكن للوالدين تتبع التغذية والنوم والحفاضات، تسجيل التطعيمات، تتبع نمو الطفل، تشغيل أصوات النوم، شراء الأجهزة من متجر إلكتروني، وتحميل مقاطع صوت البكاء للتصنيف (ألم البطن، التجشؤ، الانزعاج، الجوع، التعب).","problem":"معالجة الملفات الصوتية المرفوعة وتوقع سبب البكاء بدقة دون تعطيل استجابة API الرئيسية.","solution":"تصميم سير عمل غير متزامن يرسل التسجيلات إلى خدمة FastAPI وتخزين التوقعات مع نسبة الثقة والتشخيص."},"home-plate":{"title":"Home Plate","subtitle":"منصة توصيل الطعام وإدارة المحافظ متعددة الأدوار","description":"منظومة كاملة لتوصيل الطعام تربط بين العملاء والمطاعم وسائقي التوصيل والإدارة. بنيت باستخدام Laravel 10، Paymob، Firebase FCM، Pusher، إيصالات mPDF الضريبية، ونظام صلاحيات Spatie. تتضمن تقديم الطلبات مع منع التكرار (Idempotency)، تأكيد التسليم بالرمز السري PIN، محافظ رقمية مؤتمتة للسائقين والمطاعم، وتتبع الطلبات.","problem":"منع تكرار تقديم الطلبات، إدارة سحوبات المحافظ لعدة أطراف، وتأكيد أمان عملية التسليم.","solution":"تطبيق متطلبات Idempotency في API، جدولة سحوبات المحافظ الرقمية، استخدام رمز PIN للتسليم، وربط Paymob webhooks."},"footeek":{"title":"Footeek E-Commerce Admin","subtitle":"نظام إدارة المتاجر الإلكترونية والمخازن والعمليات للمؤسسات","description":"لوحة تحكم إدارية شاملة لإدارة المتاجر الإلكترونية الحديثة. بنيت باستخدام Laravel 12، Spatie RBAC، Maatwebsite Excel، Tailwind CSS، Vite، وAlpine.js. تمنح المدراء تحكماً كاملاً في كتالوج المنتجات، توليد المتغيرات، مستويات المخزون، التحويلات بين المخازن، تعيين شركات الشحن، إدارة طلبات الإرجاع، وتسعير المناطق.","problem":"إدارة مصفوفات المنتجات متعددة المتغيرات، حركة المخزون بين المستودعات، وتعيين مندوبي الشحن.","solution":"تطوير مصفوفة توليد المتغيرات، دفتر حركة المخزون، تصدير واستيراد ملفات Excel، وقواعد الشحن حسب المناطق."},"gobite":{"title":"GoBite Restaurant Platform","subtitle":"منظومة طلبات المطاعم وبطاقات الولاء والمكافآت","description":"منصة كاملة لإدارة المطاعم تجمع بين طلبات العملاء، تسجيل الدخول الاجتماعي، تصفح المنيو والمتغيرات، تغطية التوصيل حسب المدن والمناطق، نظام الكوبونات، محرك نقاط الولاء واستبدالها، إشعارات Firebase، ونظام تذاكر الدعم الفني.","problem":"زيادة ولاء العملاء مع أتمتة تسعير مناطق التوصيل وقواعد الخصومات.","solution":"بناء محرك احتساب نقاط الولاء واستبدالها مباشرة في الفاتورة، مع ربط إشعارات Firebase FCM الموجهة."},"movepoint":{"title":"MovePoint Field Operations","subtitle":"منصة إدارة القوى العاملة وتوجيه المبيعات الميدانية","description":"نظام لإدارة القوى العاملة يربط بين الموظفين والمشرفين والممثلين الميدانيين. يدير جداول العمل، المستهدفات الشهرية، طلبات الإجازات والسلف، إيصالات الإيداع، تدقيق المشرفين، توجيه العملاء المحتملين حسب المحافظات، وتفاصيل الرواتب عبر API في Laravel.","problem":"توجيه عملاء المبيعات الميدانية تلقائياً للممثلين حسب المحافظة مع معالجة الطلبات المالية للموظفين.","solution":"بناء محرك توجيه العملاء حسب الموقع الجغرافي، سير موافقات المشرفين، تدقيق المرفقات، وتصدير التقارير إلى Excel."},"real-estate":{"title":"Real Estate All-Stars","subtitle":"بوابة المعرض العقاري ونظام التصويت للمسابقات","description":"يجمع Real Estate All-Stars بين موقع عقاري عام ونظام إداري لإدارة المسابقات العقارية. يعرض المطورون المشاريع والوحدات في عدة دول (مصر، السعودية، الإمارات، عمان، قطر)، بينما يشارك المتسابقون في مسابقة جوائز سنوية مع تصويت برمز OTP وشراء الأصوات وتقارير PDF وExcel.","problem":"التعامل مع كثافة الزيارات أثناء التصويت وإدارة محتوى عقاري ثنائي اللغة بسلاسة.","solution":"بناء بوابة Laravel ثنائية اللغة، سجل معاملات التصويت، التقاط اهتمامات العقارات، وتقارير PDF/Excel التحليلية."}}},"services":{"eyebrow":"03 / القدرات التقنية","title":"ما أقوم به وتطويره","description":"حلول هندسية للباك إند مصممة للتوسع المؤسسي، الأداء الفوري، والتكاملات الآمنة.","items":{"backend":{"title":"هندسة الباك إند","description":"بناء بنية أنظمة Laravel 12 وPHP 8.2 مع أنماط البرمجة كائنية التوجه، تخزين Redis المؤقت، وهندسة النطاق المعيارية."},"api":{"title":"هندسة واجهات API","description":"تطوير واجهات RESTful آمنة وعالية الاستجابة مع مصادقة Sanctum/JWT، تحديد معدل الطلبات، وإدارة الإصدارات."},"ai_ml":{"title":"خدمات الذكاء الاصطناعي","description":"دمج خدمات Python & FastAPI للذكاء الاصطناعي لتنفيذ المهام المتخصصة مثل تصنيف الصوت، والتحليلات التنبؤية."},"payments_ecommerce":{"title":"المدفوعات والتجارة الإلكترونية","description":"ربط بوابات Fawaterak وPaymob، محركات الاشتراكات، مطابقة Webhooks، ومنطق سحب المحافظ الرقمية."},"realtime_notifications":{"title":"الاتصالات اللحظية والإشعارات","description":"تطوير اتصالات WebSockets عبر Pusher وإشعارات Push عبر Firebase FCM للدردشة المباشرة وتتبع الحالات."},"dashboards":{"title":"لوحات التحكم والعمليات","description":"بناء لوحات تحكم إدارية مع صلاحيات Spatie RBAC، رسوم بيانية تحليلية، إدارة المحتوى، وتقارير Excel/PDF."}}},"skills":{"eyebrow":"04 / سجل التقنيات","title":"المكدس التقني ونسبة الاستخدام","description":"تم تسجيل كل تقنية في سجل موحد. تعكس الأرقام عدد المشاريع الفعلية المبنية والمشحونة في هذا الملف.","usageLabel":"مشروع مشحون"},"contact":{"eyebrow":"05 / تواصل معي","title":"لنقم ببناء شيء موثوق.","description":"هل لديك مشروع باك إند، تحدي في بنية API، أو منتج جديد؟ لا تتردد في التواصل معي.","formName":"الاسم","formEmail":"البريد الإلكتروني","formMessage":"تفاصيل المشروع ونطاق العمل","formSubmit":"إرسال الرسالة","formSuccess":"شكراً لك! تم استلام رسالتك بنجاح."},"footer":{"copyright":"© 2026 ربيع عبد الرحمن. جميع الحقوق محفوظة.","builtWith":"تم التطوير باستخدام Next.js 15 وTypeScript وTailwind CSS","top":"العودة للأعلى"}},"children":["$L1a","$L1b"]}]
