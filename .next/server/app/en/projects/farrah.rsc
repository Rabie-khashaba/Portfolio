10:["$","$L19",null,{"locale":"en","now":"$D2026-09-09T12:34:18.948Z","timeZone":"Africa/Cairo","messages":{"nav":{"home":"Home","about":"About","projects":"Projects","services":"Services","skills":"Skills","contact":"Contact"},"site":{"logo":"R.K","role":"Laravel 12 Backend Engineer","switchLang":"العربية"},"hero":{"hello":"Hello, I’m","name":"Rabie Abdelrahman","role":"Laravel Backend Engineer · PHP & AI Systems Architect","summary":"I architect and build enterprise-grade, high-concurrency backend platforms in Laravel, PHP, Python & AI microservices — powering mobile APIs, e-commerce engines, and real-time digital products.","ctaProjects":"Explore Case Studies","ctaContact":"Get In Touch","available":"Available for Projects","experience":"5+ Years","experienceLabel":"Production Experience","shippedApps":"7 Shipped Products","shippedAppsLabel":"Enterprise Systems","apisCount":"10+ Core APIs","apisCountLabel":"Built & Deployed"},"about":{"eyebrow":"01 / Expertise","title":"Backend systems engineered for resilience, speed, and real-world scale.","text":"I specialize in constructing secure, maintainable, and high-performance backend infrastructure that powers complex business workflows. From API architecture, database schemas, and multi-tenant authentication to payment webhooks, realtime WebSockets, and AI microservices.","tags":["Laravel Backend","API Architecture","Database Optimization","Python / FastAPI ML","Payment Webhooks","Realtime WebSockets","AWS & Cloud Storage","RBAC Security"]},"projects":{"eyebrow":"02 / Case Studies","title":"Shipped Projects & Architecture","description":"Deep-dive case studies into enterprise backend platforms, food delivery engines, AI microservices, and management systems.","filterAll":"All Projects","filterMobile":"Mobile & AI Backend","filterEcommerce":"Delivery & E-Commerce","filterEnterprise":"Enterprise & Field Ops","filterRealEstate":"Real Estate & Portals","viewCaseStudy":"View Case Study","keyMetrics":"Key Performance Metrics"},"projectDetail":{"backToProjects":"← Back to Projects","overviewTitle":"Project Executive Overview","architectureTitle":"System Architecture & Layers","databaseEntitiesTitle":"Database Schema & Key Entities","apiContractsTitle":"Core API Contracts & Modules","techStackTitle":"Technologies Used","statsTitle":"Project Highlights","yearLabel":"Timeline","platformsLabel":"Target Platforms","apiEndpointsLabel":"API Endpoints","viewGithub":"Source Code","viewDemo":"Live System","items":{"farrah":{"title":"Farrah (Farra / Wanderr)","subtitle":"Social Travel & Location Discovery Mobile Backend & Admin Dashboard","description":"Farrah is a comprehensive Laravel 12 backend and administrative control system for a travel-focused social mobile app. It supports multi-role mobile authentication, social posting, ghost posts, map check-ins, Mapbox geocoding, stories, realtime chat with reactions, background video transcoding, Firebase push notifications, Fawaterak payment webhooks, paid post promotion campaigns, and admin moderation tools.","problem":"Handling high-volume social interactions, location geocoding, and background video transcoding while maintaining fast API response times.","solution":"Built a modular Laravel API with Redis queue workers for video renditions, Spatie RBAC, Pusher WebSockets for chat, Mapbox geocoding, and Fawaterak webhooks."},"baby-track":{"title":"Baby Track","subtitle":"AI Baby Care Tracking & Cry Classification Platform","description":"Baby Track combines a Laravel 12 API backend, an admin portal, and a dedicated Python FastAPI Machine Learning microservice for baby cry classification. Parents can track daily feeding, sleep, and diaper routines, record vaccinations, track growth curves, stream sleep sounds, buy devices through an e-commerce shop, and upload cry audio files for AI diagnosis (belly pain, burping, discomfort, hungry, tired).","problem":"Processing parent audio uploads and predicting cry causes accurately without blocking main API request threads.","solution":"Architected an asynchronous pipeline sending uploaded audio to a FastAPI microservice, storing predictions with confidence scores and diagnostic feedback."},"home-plate":{"title":"Home Plate","subtitle":"Multi-role Food Ordering & Delivery Management Platform","description":"Home Plate is a food delivery ecosystem connecting customers, vendors/restaurants, delivery drivers, and platform administrators. Built with Laravel 10, Paymob integration, Firebase FCM, Pusher broadcasting, mPDF tax receipts, and Spatie permission system. Features include idempotent order placement, PIN-based delivery verification, automated driver/vendor digital wallets, coupon validation, and live order chat.","problem":"Eliminating duplicate order submissions, managing multi-party wallet payouts, and ensuring order delivery security.","solution":"Implemented idempotent API request headers, automated wallet withdrawal windows, PIN code verification at delivery dropoff, and Paymob payment webhooks."},"footeek":{"title":"Footeek E-Commerce Admin","subtitle":"Enterprise E-Commerce & Warehouse Operations Management System","description":"Footeek is a central management platform for modern online stores. Built with Laravel 12, Spatie RBAC, Maatwebsite Excel, Tailwind CSS, Vite, and Alpine.js. It gives administrators full control over product cataloging, variant generation, inventory stock levels, warehouse transfers, courier assignments, return request moderation, delivery zone pricing, and financial reporting.","problem":"Managing massive multi-variant product matrices, stock movements across warehouses, and courier fulfillment assignments.","solution":"Developed bulk variant generation matrices, stocktake ledger tracking, Maatwebsite Excel export/import streams, and area-based shipping rules."},"gobite":{"title":"GoBite Restaurant Platform","subtitle":"Restaurant Ordering, Delivery & Loyalty Rewards Engine","description":"GoBite is a complete restaurant management platform combining customer ordering, Socialite login, category/variation browsing, city-area delivery coverage, coupon engines, a loyalty points earning/redemption system, Firebase push notifications, support ticket handling, and operational admin reporting.","problem":"Encouraging customer retention while automating delivery radius pricing and coupon rules.","solution":"Engineered a flexible loyalty point accumulation and redemption engine integrated directly into checkout calculations, alongside automated FCM push token alerts."},"movepoint":{"title":"MovePoint Field Operations","subtitle":"Workforce Administration & Sales Lead Routing Platform","description":"MovePoint is a workforce management system connecting employees, supervisors, and field representatives. It manages work schedules, monthly target tracking, leave/advance requests, deposit receipts, supervisor team audits, geographic sales lead referrals, salary details, and support tickets through an API-first Laravel backend.","problem":"Routing field sales leads automatically to representatives based on geographic governorates while processing employee financial requests.","solution":"Built a location-based lead routing engine, supervisor approval workflows, deposit attachment verification, and Excel spreadsheet export capabilities."},"real-estate":{"title":"Real Estate All-Stars","subtitle":"Real Estate Property Catalog & Awards Voting Platform","description":"Real Estate All-Stars combines a public real estate portal with an administrative contest management system. Developers showcase projects and units across countries (Egypt, KSA, UAE, Oman, Qatar), while contestants participate in an annual award competition featuring OTP voter verification, vote purchasing, CMS management, judge evaluation, and Excel/PDF reports.","problem":"Handling high traffic during public voting periods and managing bilingual property portfolios seamlessly.","solution":"Constructed a bilingual Laravel MVC portal with vote transactions logging, interest lead capturing, video moderation, and PDF/Excel analytical report generation."}}},"services":{"eyebrow":"03 / Capabilities","title":"What I Architect & Deliver","description":"Production-grade backend engineering solutions tailored for enterprise scalability, real-time performance, and secure integrations.","items":{"backend":{"title":"Backend Engineering","description":"Designing clean, modular Laravel 12 & PHP 8.2 backend foundations with robust OOP patterns, Redis caching, and maintainable domain architecture."},"api":{"title":"API Architecture","description":"Building secure, high-concurrency RESTful APIs with Sanctum/JWT authentication, rate limiting, versioning, and comprehensive documentation."},"ai_ml":{"title":"AI & ML Microservices","description":"Integrating Python & FastAPI machine learning microservices for specialized tasks like audio classification, predictive analytics, and data processing."},"payments_ecommerce":{"title":"Payments & E-Commerce","description":"Integrating Fawaterak and Paymob payment gateways, subscription engines, webhook reconciliation, and digital wallet withdrawal logic."},"realtime_notifications":{"title":"Realtime & Push Messaging","description":"Implementing WebSockets with Pusher and push notifications via Firebase FCM for live chat, status tracking, and instant alerts."},"dashboards":{"title":"Admin & Operations Control","description":"Building powerful administrative control panels with Spatie RBAC permissions, analytics charts, content management, and Excel/PDF reporting."}}},"skills":{"eyebrow":"04 / Tech Registry","title":"Technology Stack & Shipped Usage","description":"Every technology is tracked in a single registry. Usage counts reflect real production projects built and shipped in this portfolio.","usageLabel":"Shipped Projects"},"contact":{"eyebrow":"05 / Get In Touch","title":"Let’s Build Something Reliable.","description":"Have a backend project, API architecture challenge, or new product in mind? Feel free to reach out.","formName":"Your Name","formEmail":"Your Email","formMessage":"Project Details & Scope","formSubmit":"Send Message","formSuccess":"Thank you! Your message has been received."},"footer":{"copyright":"© 2026 Rabie Abdelrahman. All rights reserved.","builtWith":"Built with Next.js 15, TypeScript & Tailwind CSS","top":"Back to top"}},"children":["$L1a","$L1b"]}]
